{
  "name": "@binarynoir/vitepress-blog",
  "version": "0.7.1",
  "description": "Turn any VitePress 2 page into a blog post with frontmatter. A main blog, folder-scoped section blogs, sticky posts, pagination, keyword filters and an RSS feed for each.",
  "keywords": [
    "vitepress",
    "vitepress-plugin",
    "markdown-it",
    "markdown-it-plugin",
    "blog",
    "rss",
    "rss-feed",
    "feed",
    "pagination",
    "tags",
    "docs",
    "documentation"
  ],
  "license": "MIT",
  "author": "BinaryNoir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binarynoir/vitepress-blog.git"
  },
  "homepage": "https://github.com/binarynoir/vitepress-blog#readme",
  "bugs": {
    "url": "https://github.com/binarynoir/vitepress-blog/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress.d.ts",
      "import": "./dist/vitepress.js",
      "require": "./dist/vitepress.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "markdown-it": "^15.0.0",
    "vitepress": "^1.0.0 || ^2.0.0-0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.3",
    "markdown-it": "^15.0.2",
    "prettier": "^3.9.8",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1",
    "vue": "^3.5.0"
  }
}
